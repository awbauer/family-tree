{
  // Build input only, never deployed on its own: Flue's Vite plugin needs a Worker config to generate the agents'
  // entry and Durable Object classes. `npm run build:agents` builds them into agents/dist/agents_bundle, and the one
  // Worker (worker/main.js, the root wrangler.jsonc) bundles that with the site. The deployed bindings, Durable
  // Object migrations and cron trigger live in the root wrangler.jsonc.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents-bundle",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "d1_databases": [
    { "binding": "DB", "database_name": "family-tree", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }
  ]
}

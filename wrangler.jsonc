{
  // Cloudflare Worker config template. See docs/agents/operations.md → "Automatic deploys".
  // Your real IDs never go in this file: local deploys use the git-ignored wrangler.local.jsonc, and Workers Builds
  // generates wrangler.ci.jsonc from this file (tools/ci_config.mjs) with D1_DATABASE_ID from its build variables.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-tree",
  // One Worker for the site and the AI agents: worker/main.js hands requests to the site (worker/index.js) and bundles
  // the agents, built by `npm run build:agents` (agents/, Flue on Durable Objects).
  "main": "worker/main.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/site", // built by `npm run build:web` from web/ (Vite + React)
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/mcp"]
  },
  // Serve only on your Access-protected custom domain: no workers.dev URL, no public version/preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-tree",
      "migrations_dir": "migrations",
      // Placeholder. The Deploy to Cloudflare button creates a database and writes its id into your copy of the
      // repo; manual setups put the real id in the git-ignored wrangler.local.jsonc instead.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "family-tree-media" }
  ],
  // Runtime variables live in the Cloudflare dashboard (Workers & Pages → family-tree → Settings → Variables and
  // Secrets), not here: ACCESS_TEAM_DOMAIN, ACCESS_AUD, OWNER_EMAIL, and optionally CF_ACCOUNT_ID, ACCESS_GROUP_ID
  // plus the CF_API_TOKEN secret (automatic Access invites). keep_vars stops deploys from deleting them. Don't add a
  // "vars" block: any variable listed here would overwrite the dashboard value on every deploy.
  // Workers AI: the agents' models through AI Gateway, Cloudflare's Web Search API, and page-to-Markdown conversion.
  "ai": { "binding": "AI" },
  // One Durable Object class per agent (Flue generates the classes; their names must match agents/src/agents).
  "durable_objects": {
    "bindings": [
      {"name": "FLUE_ASSISTANT_AGENT", "class_name": "FlueAssistantAgent"},
      {"name": "FLUE_PROFILE_WRITER_AGENT", "class_name": "FlueProfileWriterAgent"},
      {"name": "FLUE_STORY_REVIEWER_AGENT", "class_name": "FlueStoryReviewerAgent"},
      {"name": "FLUE_STORY_LIBRARIAN_AGENT", "class_name": "FlueStoryLibrarianAgent"},
      {"name": "FLUE_QUALITY_REVIEWER_AGENT", "class_name": "FlueQualityReviewerAgent"},
      {"name": "FLUE_RESEARCHER_AGENT", "class_name": "FlueResearcherAgent"},
      {"name": "FLUE_SHERLOCK_AGENT", "class_name": "FlueSherlockAgent"},
      {"name": "FLUE_STORY_WRITER_AGENT", "class_name": "FlueStoryWriterAgent"}
    ]
  },
  // Append new entries, never edit deployed ones. Sites that ran the agents as a separate Worker (family-tree-agents)
  // move their stored agents here instead: tools/ci_config.mjs turns v1 into a transfer when that Worker exists.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FlueResearcherAgent", "FlueProfileWriterAgent", "FlueStoryReviewerAgent", "FlueAssistantAgent", "FlueQualityReviewerAgent", "FlueStoryWriterAgent", "FlueStoryLibrarianAgent", "FlueSherlockAgent"] }
  ],
  // Weekly content job (AI profiles), Sundays 03:23 UTC (agents/src/cloudflare.js). Does nothing unless
  // CONTENT_JOB_ENABLED=true.
  "triggers": { "crons": ["23 3 * * SUN"] },
  // Workers Logs and Traces, everything kept: every invocation (request URL, status, timing), every console line, and
  // every trace span, unsampled. Readable only by members of the Cloudflare account (Workers → this Worker →
  // Observability). Request and response bodies are never logged; agent traces carry no prompt or tool content.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": true, "head_sampling_rate": 1, "persist": true }
  },
  "keep_vars": true
}
